{
	"schemaVersion": 1,
	"id": "custom-server-mod",
	"version": "${version}",
	"name": "ServerCraft",
	"description": "Requires Fabric on both client and server — Infinite Totem (30s cooldown, 8 Netherite Blocks + Totem), Lumberjack, Telekinesis, Excavation 3x3, Auto Smelting, MsgSpy, VersionCheck. For Minecraft 26.2 Chaos Cubed.",
	"authors": [
		"Teufel2211"
	],
	"contact": {},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.customservermod.CustomServerMod"
		],
		"client": [
			"com.example.customservermod.version.VersionCheckerClient"
		],
		"server": [
			"com.example.customservermod.CustomServerModServer"
		]
	},
	"mixins": [
		"custom-server-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}